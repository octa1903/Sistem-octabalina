# Sistema Octabalina - Variables de entorno
# Copia este archivo a .env y completa con los valores reales de tu proyecto Supabase.

# URL del proyecto Supabase: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Clave anon (pública, segura para exponer en el cliente — RLS protege acceso)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Modo offline-first: si true, las mutaciones se encolan localmente cuando falla la red
VITE_OFFLINE_MODE=true
