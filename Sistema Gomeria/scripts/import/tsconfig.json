{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["ES2022"],
    "paths": {
      "@/*": ["../../src/*"]
    },
    "types": ["node"]
  },
  "include": [".", "../../src/types/database.ts"]
}
